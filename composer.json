{
    "name": "sammorrowdrums/mcp-php-starter",
    "description": "A feature-complete Model Context Protocol (MCP) server template in PHP",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Sam Morrowdrums"
        }
    ],
    "require": {
        "php": ">=8.2",
        "mcp/sdk": "^0.8.1",
        "nyholm/psr7": "^1.8.2",
        "nyholm/psr7-server": "^1.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^11.5.56"
    },
    "autoload": {
        "psr-4": {
            "McpPhpStarter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "McpPhpStarter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "start:stdio": "php bin/server-stdio.php",
        "start:http": "php bin/server-http.php",
        "test": "phpunit --bootstrap vendor/autoload.php tests",
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable"
}
